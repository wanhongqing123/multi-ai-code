.vscode/
.idea/
*.swp
*.swo

# Xcode / CocoaPods local generated state
MaiChat/ios/**/Pods/
MaiChat/ios/**/xcuserdata/
MaiChat/ios/**/*.xcuserstate

# Android / Gradle local generated state
MaiChat/android/**/.gradle/
MaiChat/android/**/build/
MaiChat/android/**/*.iml
MaiChat/android/**/local.properties

# Env files
.env
.env.local
.env.*.local

# Claude Code local state
.claude/

# Codex local project config
.codex/config.toml

# Superpowers brainstorming / visual-companion session state
.superpowers/

# Local git worktrees
.worktrees/

# Multi-AI Code 已不再往目标仓库写任何东西（方案文档 / 仓库记忆 / 分析缓存 /
# 系统提示词注入，四条链路都已删除）。保留这两条忽略规则只是兜底：万一有人跑
# 旧版本安装包，生成的残留不会污染 git。
.multi-ai-code/
.injections/

# Local Whisper runtime binaries are generated during packaging.
# The shared Whisper model under resources/asr/models is tracked by Git LFS.
models/whisper/*.bin
resources/asr/**/bin/*
resources/asr/**/lib/*
resources/asr/**/licenses/*
!resources/asr/README.md
!resources/asr/**/.gitkeep

# Playwright MCP 浏览器工具的临时产物（页面快照/控制台日志）
.playwright-mcp/
