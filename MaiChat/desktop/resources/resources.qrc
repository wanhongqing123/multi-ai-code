<RCC>
  <qresource prefix="/maichat">
    <file alias="app-icon.png">macos/AppIcon-1024.png</file>
  </qresource>
  <!-- 桌面端字体栈：Inter（拉丁）+ Noto Sans SC（中文）+ JetBrains Mono（等宽）。
       许可均为 SIL OFL 1.1，文本在 fonts/ 下随包分发。 -->
  <qresource prefix="/maichat/fonts">
    <file alias="Inter-latin-400.ttf">fonts/Inter-latin-400.ttf</file>
    <file alias="Inter-latin-500.ttf">fonts/Inter-latin-500.ttf</file>
    <file alias="Inter-latin-600.ttf">fonts/Inter-latin-600.ttf</file>
    <file alias="Inter-latin-700.ttf">fonts/Inter-latin-700.ttf</file>
    <file alias="NotoSansSC-Regular.otf">fonts/NotoSansSC-Regular.otf</file>
    <file alias="NotoSansSC-Medium.otf">fonts/NotoSansSC-Medium.otf</file>
    <file alias="NotoSansSC-Bold.otf">fonts/NotoSansSC-Bold.otf</file>
    <file alias="JetBrainsMono-latin-400.ttf">fonts/JetBrainsMono-latin-400.ttf</file>
    <file alias="JetBrainsMono-latin-700.ttf">fonts/JetBrainsMono-latin-700.ttf</file>
  </qresource>
  <qresource prefix="/maichat/avatars">
    <file alias="a.svg">avatars/a.svg</file>
    <file alias="b.svg">avatars/b.svg</file>
    <file alias="c.svg">avatars/c.svg</file>
    <file alias="d.svg">avatars/d.svg</file>
    <file alias="e.svg">avatars/e.svg</file>
    <file alias="f.svg">avatars/f.svg</file>
    <file alias="g.svg">avatars/g.svg</file>
    <file alias="h.svg">avatars/h.svg</file>
    <file alias="i.svg">avatars/i.svg</file>
    <file alias="j.svg">avatars/j.svg</file>
    <file alias="k.svg">avatars/k.svg</file>
    <file alias="l.svg">avatars/l.svg</file>
    <file alias="m.svg">avatars/m.svg</file>
    <file alias="n.svg">avatars/n.svg</file>
    <file alias="o.svg">avatars/o.svg</file>
    <file alias="p.svg">avatars/p.svg</file>
    <file alias="q.svg">avatars/q.svg</file>
    <file alias="r.svg">avatars/r.svg</file>
    <file alias="s.svg">avatars/s.svg</file>
    <file alias="t.svg">avatars/t.svg</file>
    <file alias="u.svg">avatars/u.svg</file>
    <file alias="v.svg">avatars/v.svg</file>
    <file alias="w.svg">avatars/w.svg</file>
    <file alias="x.svg">avatars/x.svg</file>
    <file alias="y.svg">avatars/y.svg</file>
    <file alias="z.svg">avatars/z.svg</file>
  </qresource>
  <!-- Tabler Icons v3.x, MIT. Original SVGs and license live together. -->
  <qresource prefix="/maichat/icons">
    <file alias="message-circle.svg">icons/tabler/message-circle.svg</file>
    <file alias="sparkles.svg">icons/tabler/sparkles.svg</file>
    <file alias="users.svg">icons/tabler/users.svg</file>
    <file alias="device-desktop.svg">icons/tabler/device-desktop.svg</file>
    <file alias="settings.svg">icons/tabler/settings.svg</file>
    <file alias="message-circle-filled.svg">icons/tabler/message-circle-filled.svg</file>
    <file alias="sparkles-filled.svg">icons/tabler/sparkles-filled.svg</file>
    <file alias="users-filled.svg">icons/tabler/users-filled.svg</file>
    <file alias="device-desktop-filled.svg">icons/tabler/device-desktop-filled.svg</file>
    <file alias="settings-filled.svg">icons/tabler/settings-filled.svg</file>
    <file alias="arrow-up.svg">icons/tabler/arrow-up.svg</file>
    <file alias="terminal-2.svg">icons/tabler/terminal-2.svg</file>
    <file alias="user-circle.svg">icons/tabler/user-circle.svg</file>
    <file alias="tabler-license.txt">icons/tabler/LICENSE.txt</file>
  </qresource>
</RCC>
