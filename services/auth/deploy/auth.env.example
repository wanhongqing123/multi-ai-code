MAICHAT_AUTH_PORT=9100
MAICHAT_AUTH_DB_PATH=/var/lib/maichat-auth/auth.sqlite
# Admin UI binds only 127.0.0.1; reach it through SSH port forwarding.
MAICHAT_AUTH_ADMIN_PORT=9101
# Set a separate random secret with at least 32 characters on the server.
# MAICHAT_AUTH_ADMIN_SECRET=
MAICHAT_AUTH_HMAC_KEY=replace-with-random-secret-at-least-32-characters
# Keep 0 during mobile rollout. Set to 1 when old mobile clients may be signed out.
# Starting with 1 revokes existing sessions that have no device_slot.
MAICHAT_AUTH_REQUIRE_DEVICE_SLOT=0
MAICHAT_IM_SDK_APP_ID=replace-with-current-tencent-im-sdk-app-id
MAICHAT_IM_SECRET_KEY=replace-with-server-side-tencent-im-signing-key
# Optional social login providers. Leave unset until the official apps are approved.
# AppSecret stays only in this server environment file; never put it in an App bundle.
# MAICHAT_WECHAT_APP_ID=
# MAICHAT_WECHAT_APP_SECRET=
# MAICHAT_QQ_APP_ID=
# Must match model-credentials.env; never deliver this loopback service token to an App.
MAICHAT_AUTH_SERVICE_TOKEN=replace-with-different-random-token-at-least-32-characters
MAICHAT_MODEL_CREDENTIAL_PORT=9200
# Tencent ASR issues 30-minute realtime-only STS credentials for client-side signing.
# These permanent keys stay on the server; audio flows directly from clients to Tencent.
# MAICHAT_ASR_APP_ID=replace-with-tencent-asr-app-id
# MAICHAT_ASR_SECRET_ID=replace-with-tencent-asr-secret-id
# MAICHAT_ASR_SECRET_KEY=replace-with-tencent-asr-secret-key
# Optional Aliyun NLS control plane; never use SMS or OSS credentials implicitly.
# MAICHAT_NLS_APP_KEY=replace-with-nls-project-app-key
# MAICHAT_NLS_ACCESS_KEY_ID=replace-with-authorized-nls-ram-access-key-id
# MAICHAT_NLS_ACCESS_KEY_SECRET=replace-with-authorized-nls-ram-access-key-secret
MAICHAT_SMS_ACCESS_KEY_ID=replace-with-dedicated-sms-ram-access-key-id
MAICHAT_SMS_ACCESS_KEY_SECRET=replace-with-dedicated-sms-ram-access-key-secret
MAICHAT_SMS_SIGN_NAME=replace-with-approved-sign-name
MAICHAT_SMS_TEMPLATE_CODE=SMS_123456789
# Private video cloud drive remains disabled until real OSS multipart acceptance.
# Set the same internal key on auth and media signer processes when enabling.
# MAICHAT_CLOUD_DRIVE_ENABLED=0
# On canary rollout, list exact MaiChat account IDs. Unset or * allows every account when enabled.
# MAICHAT_CLOUD_DRIVE_ALLOWED_ACCOUNTS=cloud_owner,cloud_viewer
# MAICHAT_CLOUD_DRIVE_INTERNAL_KEY=replace-with-separate-random-secret-at-least-32-characters
# MAICHAT_CLOUD_DRIVE_MAX_VIDEO_BYTES=2000000000
# MAICHAT_CLOUD_DRIVE_QUOTA_BYTES=10000000000
