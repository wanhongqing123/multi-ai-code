MAICHAT_AUTH_PORT=9100
MAICHAT_AUTH_DB_PATH=/var/lib/maichat-auth/auth.sqlite
MAICHAT_AUTH_HMAC_KEY=replace-with-random-secret-at-least-32-characters
# Keep 0 during mobile rollout. Set to 1 when old mobile clients may be signed out.
# Starting with 1 revokes existing sessions that have no device_slot.
MAICHAT_AUTH_REQUIRE_DEVICE_SLOT=0
# Paid model access has its own explicit allowlist; empty means no account can receive keys.
MAICHAT_MODEL_ALLOWED_PHONES=replace-with-approved-phone-number
MAICHAT_IM_SDK_APP_ID=replace-with-current-tencent-im-sdk-app-id
MAICHAT_IM_SECRET_KEY=replace-with-server-side-tencent-im-signing-key
# Optional social login providers. Leave unset until the official apps are approved.
# AppSecret stays only in this server environment file; never put it in an App bundle.
# MAICHAT_WECHAT_APP_ID=
# MAICHAT_WECHAT_APP_SECRET=
# MAICHAT_QQ_APP_ID=
# Must match media.env; never deliver this loopback service token to an App.
MAICHAT_AUTH_SERVICE_TOKEN=replace-with-different-random-token-at-least-32-characters
MAICHAT_MEDIA_PORT=9000
MAICHAT_SMS_ACCESS_KEY_ID=replace-with-dedicated-sms-ram-access-key-id
MAICHAT_SMS_ACCESS_KEY_SECRET=replace-with-dedicated-sms-ram-access-key-secret
MAICHAT_SMS_SIGN_NAME=replace-with-approved-sign-name
MAICHAT_SMS_TEMPLATE_CODE=SMS_123456789
