[Unit]
Description=MaiChat authentication service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=maichatauth
Group=maichatauth
UMask=0077
WorkingDirectory=/opt/maichat/auth
EnvironmentFile=/etc/maichat/auth.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/maichat-auth
PrivateTmp=true

[Install]
WantedBy=multi-user.target
