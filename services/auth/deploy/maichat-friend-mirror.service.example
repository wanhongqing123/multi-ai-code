[Unit]
Description=Refresh MaiChat friend migration mirror from Tencent IM
After=network-online.target maichat-auth.service
Wants=network-online.target

[Service]
Type=oneshot
User=maichatauth
Group=maichatauth
UMask=0077
WorkingDirectory=/opt/maichat/auth
EnvironmentFile=/etc/maichat/auth.env
ExecStart=/usr/bin/node /opt/maichat/auth/friend-mirror.js --run
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/maichat-auth
PrivateTmp=true
