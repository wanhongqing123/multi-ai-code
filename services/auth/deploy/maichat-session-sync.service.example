[Unit]
Description=MaiChat device Session synchronization service
After=network-online.target maichat-auth.service
Wants=network-online.target
Requires=maichat-auth.service

[Service]
Type=simple
User=maichatsync
Group=maichatsync
UMask=0077
WorkingDirectory=/opt/maichat/auth
EnvironmentFile=/etc/maichat/session-sync.env
ExecStart=/usr/bin/node session-sync-server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/maichat-session-sync
PrivateTmp=true

[Install]
WantedBy=multi-user.target
