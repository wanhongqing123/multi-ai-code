location ^~ /api/v1/session-sync/ {
    limit_req zone=maichat_session_sync burst=30 nodelay;
    client_max_body_size 128k;
    access_log off;
    proxy_pass http://127.0.0.1:9102/v1/session-sync/;
    proxy_http_version 1.1;
    proxy_set_header Host 127.0.0.1;
    proxy_set_header Authorization $http_authorization;
    proxy_read_timeout 25s;
    proxy_buffering off;
    add_header Cache-Control "no-store" always;
}

# Define in the http context:
# limit_req_zone $binary_remote_addr zone=maichat_session_sync:10m rate=120r/m;
