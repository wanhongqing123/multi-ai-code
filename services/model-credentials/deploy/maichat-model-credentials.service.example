[Unit]
Description=MaiChat model credential issuer
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=maichat
Group=maichat
WorkingDirectory=/opt/maichat/model-credentials
EnvironmentFile=/etc/maichat/model-credentials.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
