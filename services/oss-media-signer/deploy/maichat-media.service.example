[Unit]
Description=MaiChat media signing and Ark Assets service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=maichat
Group=maichat
WorkingDirectory=/opt/maichat/media
EnvironmentFile=/etc/maichat/media.env
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
