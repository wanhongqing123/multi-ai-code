MAICHAT_MEDIA_PORT=9000
MAICHAT_AUTH_PORT=9100
VOLC_ACCESS_KEY_ID=replace-with-volc-access-key-id
VOLC_SECRET_ACCESS_KEY=replace-with-volc-secret-access-key
VOLC_ARK_PROJECT_NAME=default
# OSS is optional and can be configured later.
# MAICHAT_OSS_BUCKET=maichat-ai-video-resource
# MAICHAT_OSS_REGION=oss-cn-guangzhou
# ALIBABA_CLOUD_ACCESS_KEY_ID=replace-with-dedicated-ram-access-key-id
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=replace-with-dedicated-ram-access-key-secret
# Private cloud drive stays off until OSS multipart, length signing and lifecycle pass real tests.
# MAICHAT_CLOUD_DRIVE_ENABLED=0
# MAICHAT_CLOUD_DRIVE_INTERNAL_KEY=replace-with-the-same-secret-as-auth-at-least-32-characters
# Cloud drive uses a separate private bucket and dedicated RAM credentials.
# There is deliberately no fallback to MAICHAT_OSS_BUCKET or ALIBABA_CLOUD_ACCESS_KEY_*.
# MAICHAT_CLOUD_DRIVE_OSS_BUCKET=maichat-private-cloud-drive-gz-20261025-f346b709
# MAICHAT_CLOUD_DRIVE_OSS_REGION=oss-cn-guangzhou
# MAICHAT_CLOUD_DRIVE_OSS_ACCESS_KEY_ID=replace-with-cloud-drive-ram-access-key-id
# MAICHAT_CLOUD_DRIVE_OSS_ACCESS_KEY_SECRET=replace-with-cloud-drive-ram-access-key-secret
