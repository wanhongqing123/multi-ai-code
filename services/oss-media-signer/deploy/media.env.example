MAICHAT_MEDIA_PORT=9000
MAICHAT_MEDIA_SERVICE_TOKEN=replace-with-random-token-at-least-32-characters
# Only the loopback account service knows this separate token.
MAICHAT_AUTH_SERVICE_TOKEN=replace-with-different-random-token-at-least-32-characters
MAICHAT_SEEDANCE_MODEL_IDS=doubao-seedance-2-0-mini-260615,doubao-seedance-2-0-fast-260128,doubao-seedance-2-0-260128
VOLC_ACCESS_KEY_ID=replace-with-volc-access-key-id
VOLC_SECRET_ACCESS_KEY=replace-with-volc-secret-access-key
VOLC_ARK_PROJECT_NAME=default
# MAICHAT_GLM_API_KEY=replace-with-glm-api-key
