# Place limit_req_zone in the http context, before the server blocks.
limit_req_zone $binary_remote_addr zone=maichat_keys:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=maichat_avatar:10m rate=20r/s;

# Place this location in the TLS server block for the chosen domain.
location = /maichat/portrait-auth-callback {
    limit_except GET { deny all; }
    limit_req zone=maichat_keys burst=10 nodelay;
    access_log off;
    proxy_pass http://127.0.0.1:9000/portrait-auth-callback;
    proxy_set_header Host 127.0.0.1;
    add_header Cache-Control "no-store" always;
    add_header Referrer-Policy "no-referrer" always;
}

# 临时模型凭据只能由本机账号服务调用，不接受公网请求。
location = /maichat/temporary-credentials { return 404; }
location = /maichat/account-model-keys { return 404; }
location = /maichat/credentials { return 404; }

# Avatar URLs in IM profiles are stable; the service redirects each GET to a
# fresh short-lived read URL for the private OSS object.
location ^~ /maichat/avatars/ {
    limit_except GET { deny all; }
    limit_req zone=maichat_avatar burst=40 nodelay;
    access_log off;
    proxy_pass http://127.0.0.1:9000/avatars/;
    proxy_set_header Host 127.0.0.1;
    add_header Referrer-Policy "no-referrer" always;
}

location ^~ /maichat/ {
    limit_except POST { deny all; }
    limit_req zone=maichat_keys burst=10 nodelay;
    client_max_body_size 8k;
    access_log off;
    proxy_pass http://127.0.0.1:9000/;
    proxy_http_version 1.1;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Host 127.0.0.1;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 40s;
    add_header Cache-Control "no-store" always;
}
